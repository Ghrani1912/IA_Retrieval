# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/platform

# OpenSearch
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_INDEX=chunks

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=chunks

# Object cache (local filesystem — MinIO CE was archived April 2026, replaced with fs cache)
# In Docker: mount ia_cache_data volume to /cache
# Locally: set to any writable directory
OBJECT_CACHE_DIR=/cache

# Redis (arq)
REDIS_URL=redis://localhost:6379

# LLM
LLM_API_KEY=your-api-key-here
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1

# Embeddings
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Internet Archive
IA_BASE_URL=https://archive.org
CDX_RATE_LIMIT_RPS=1
